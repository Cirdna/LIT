# Copy to .env and adjust. The docker-compose service below matches these defaults.
DATABASE_URL="postgresql://aithena:aithena@localhost:5432/aithena?schema=public"

# API server
PORT=3001
HOST=0.0.0.0

# Absolute or relative path to the shared storage root (the OTHER half of the seam).
# The Python worker must be pointed at the SAME directory.
STORAGE_ROOT="./storage"

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN="http://localhost:5173"
